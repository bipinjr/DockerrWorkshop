{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "routes": [
    { "src": "^/api/(.*)", "dest": "/api/$1.py" },
    { "src": ".*", "dest": "/index.html" }
  ],
  "functions": {
    "api/agent.py": {
      "runtime": "python3.11",
      "maxDuration": 30
    },
    "api/health.py": {
      "runtime": "python3.11",
      "maxDuration": 10
    }
  },
  "env": {
    "GROQ_MODEL": "qwen/qwen3.8-27b",
    "GROQ_TIMEOUT": "30"
  }
}
